{
  "name": "mdpsn-basic-spa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["client"],
  "scripts": {
    "dev": "concurrently -n api,vite -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
